DISCORD_TOKEN=replace-with-your-bot-token
DISCORD_CLIENT_ID=replace-with-your-application-client-id

# Optional: register commands to one guild during development.
DISCORD_GUILD_ID=

# Storage:
# - SQLite is simplest for development and one-machine hosting.
# - PostgreSQL is better for hosted DB services or multi-container production.
# Examples:
# DATABASE_URL=sqlite:./plural-tts.db
# DATABASE_URL=postgresql://plural_tts:change-me@localhost:15432/plural_tts
# DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require
DATABASE_URL=sqlite:./plural-tts.db

# Optional Docker-only database override. Leave blank to use /data/plural-tts.db
# in the bot container, or set to a hosted PostgreSQL URL.
BOT_DATABASE_URL=

# Optional local PostgreSQL sidecar settings for:
# docker compose --profile postgres up -d postgres
POSTGRES_DB=plural_tts
POSTGRES_USER=plural_tts
POSTGRES_PASSWORD=change-me

# Piper can be called as a CLI or HTTP sidecar. HTTP is best for Docker Compose.
TTS_PROVIDER=piper-http
PIPER_BIN=piper
PIPER_URL=http://127.0.0.1:18950
PIPER_VOICES_DIR=./voices
DEFAULT_VOICE_ID=en_GB-northern_english_male-medium

MAX_QUEUE_LENGTH=25
MAX_SPOKEN_LENGTH=500
NORMAL_MESSAGE_DELAY_MS=1200
SPEAKER_NAME_RESET_MS=300000
AUTO_DISCONNECT_MS=300000
VOICE_CHANNEL_ONLY=true
TTS_TIMEOUT_MS=15000
TTS_RETRY_ATTEMPTS=1
TTS_RETRY_DELAY_MS=500

PLURALKIT_API_BASE=https://api.pluralkit.me/v2
PLURALKIT_USER_AGENT=PluralTTS/0.1.0
PLURALKIT_LOOKUP_TIMEOUT_MS=3000
PLURALKIT_WEBHOOK_LOOKUP_ATTEMPTS=4
PLURALKIT_WEBHOOK_LOOKUP_DELAY_MS=500

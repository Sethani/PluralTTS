{
  "name": "plural-tts",
  "version": "0.1.0",
  "description": "A Discord voice-channel TTS bot with basic PluralKit support.",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "register-commands": "tsx src/registerCommands.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@discordjs/opus": "^0.10.0",
    "@discordjs/voice": "^0.19.0",
    "better-sqlite3": "^12.2.0",
    "discord.js": "^14.22.1",
    "dotenv": "^17.2.2",
    "ffmpeg-static": "^5.2.0",
    "pino": "^9.9.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.3.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
